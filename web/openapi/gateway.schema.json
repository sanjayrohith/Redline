{
  "$comment": "Hand-maintained mirror of the gateway's wire types (internal/api/*.go). scripts/generate-client.mjs reads this file and emits src/lib/api/types.ts and src/lib/api/client.ts, so the frontend and gateway can only drift apart if this file falls out of sync with the Go source - not silently at the call site.",
  "types": {
    "ChatMessage": {
      "role": "string",
      "content": "string"
    },
    "ChatCompletionRequest": {
      "model": "string",
      "messages": "ChatMessage[]",
      "temperature?": "number",
      "top_p?": "number",
      "max_tokens?": "number",
      "stream?": "boolean"
    },
    "ChatCompletionUsage": {
      "prompt_tokens": "number",
      "completion_tokens": "number",
      "total_tokens": "number"
    },
    "ChatCompletionChoice": {
      "index": "number",
      "message": "ChatMessage",
      "finish_reason": "string"
    },
    "ChatCompletionResponse": {
      "id": "string",
      "object": "string",
      "created": "number",
      "model": "string",
      "choices": "ChatCompletionChoice[]",
      "usage": "ChatCompletionUsage"
    },
    "ChatCompletionChunkDelta": {
      "role?": "string",
      "content?": "string"
    },
    "ChatCompletionChunkChoice": {
      "index": "number",
      "delta": "ChatCompletionChunkDelta",
      "finish_reason": "string | null"
    },
    "ChatCompletionChunk": {
      "id": "string",
      "object": "string",
      "created": "number",
      "model": "string",
      "choices": "ChatCompletionChunkChoice[]",
      "usage?": "ChatCompletionUsage"
    },
    "ModelObject": {
      "id": "string",
      "object": "string",
      "created": "number",
      "owned_by": "string"
    },
    "ModelListResponse": {
      "object": "string",
      "data": "ModelObject[]"
    },
    "APIError": {
      "error": "APIErrorDetail"
    },
    "APIErrorDetail": {
      "code": "string",
      "message": "string",
      "request_id?": "string"
    },
    "APIKeyView": {
      "id": "string",
      "display_prefix": "string",
      "scopes": "string[]",
      "last_used_at?": "string",
      "revoked_at?": "string",
      "created_at": "string",
      "key?": "string"
    },
    "APIKeyListResponse": {
      "data": "APIKeyView[]"
    },
    "CreateAPIKeyRequest": {
      "scopes": "string[]"
    },
    "IngestionJobView": {
      "id": "string",
      "repo_url": "string",
      "revision": "string",
      "state": "string",
      "bytes_total": "number",
      "bytes_downloaded": "number",
      "error_message?": "string",
      "model_id?": "string"
    },
    "CreateIngestionRequest": {
      "repo_url": "string",
      "revision?": "string"
    },
    "ModelDetailView": {
      "id": "string",
      "repo_url": "string",
      "revision": "string",
      "revision_sha": "string",
      "architecture": "string",
      "parameter_count": "number",
      "dtype": "string",
      "vram_estimate_fp16_bytes": "number",
      "vram_estimate_fp8_bytes": "number",
      "vram_estimate_int4_bytes": "number",
      "kv_cache_bytes": "number",
      "license": "string",
      "created_at": "number"
    },
    "ModelCatalogResponse": {
      "data": "ModelDetailView[]"
    }
  },
  "endpoints": [
    {
      "name": "createChatCompletion",
      "method": "POST",
      "path": "/v1/chat/completions",
      "auth": "apiKey",
      "request": "ChatCompletionRequest",
      "response": "ChatCompletionResponse"
    },
    {
      "name": "listModels",
      "method": "GET",
      "path": "/v1/models",
      "auth": "apiKey",
      "response": "ModelListResponse"
    },
    {
      "name": "createAPIKey",
      "method": "POST",
      "path": "/v1/api-keys",
      "auth": "session",
      "request": "CreateAPIKeyRequest",
      "response": "APIKeyView"
    },
    {
      "name": "listAPIKeys",
      "method": "GET",
      "path": "/v1/api-keys",
      "auth": "session",
      "response": "APIKeyListResponse"
    },
    {
      "name": "revokeAPIKey",
      "method": "DELETE",
      "path": "/v1/api-keys/{id}",
      "auth": "session",
      "pathParams": ["id"]
    },
    {
      "name": "createIngestion",
      "method": "POST",
      "path": "/v1/ingestions",
      "auth": "session",
      "request": "CreateIngestionRequest",
      "response": "IngestionJobView"
    },
    {
      "name": "getIngestion",
      "method": "GET",
      "path": "/v1/ingestions/{id}",
      "auth": "session",
      "pathParams": ["id"],
      "response": "IngestionJobView"
    },
    {
      "name": "listDashboardModels",
      "method": "GET",
      "path": "/v1/dashboard/models",
      "auth": "session",
      "response": "ModelCatalogResponse"
    },
    {
      "name": "getDashboardModel",
      "method": "GET",
      "path": "/v1/dashboard/models/{id}",
      "auth": "session",
      "pathParams": ["id"],
      "response": "ModelDetailView"
    }
  ]
}
